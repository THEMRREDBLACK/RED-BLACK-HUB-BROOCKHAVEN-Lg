local function CollectEnvs()
    local list = {}
    local function add(t)
        if type(t) == "table" then
            for _, v in ipairs(list) do
                if v == t then return end
            end
            table.insert(list, t)
        end
    end

    pcall(function() if type(getgenv) == "function" then add(getgenv()) end end)
    pcall(function() if type(getfenv) == "function" then add(getfenv(0)) end end)
    pcall(function() if type(getfenv) == "function" then add(getfenv(1)) end end)
    pcall(function() if type(getfenv) == "function" then add(getfenv(2)) end end)
    add(_G)
    add(shared)

    return list
end

local function FindInEnvs(key)
    for _, env in ipairs(CollectEnvs()) do
        local ok, val = pcall(function()
            return rawget(env, key)
        end)
        if ok and val ~= nil then
            return val
        end
        local okIdx, valIdx = pcall(function()
            return env[key]
        end)
        if okIdx and valIdx ~= nil then
            return valIdx
        end
    end
    return nil
end

local function GetRequestFn()
    local names = { "request", "http_request" }
    for _, name in ipairs(names) do
        local fn = FindInEnvs(name)
        if type(fn) == "function" then
            return fn
        end
    end

    local tables = { "http", "syn", "fluxus", "krnl", "http_request" }
    for _, tName in ipairs(tables) do
        local tbl = FindInEnvs(tName)
        if type(tbl) == "table" and type(tbl.request) == "function" then
            return tbl.request
        end
    end

    return nil
end

local function GetDeviceInfo()
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.MouseEnabled
    local isConsole = GuiService:IsTenFootInterface()

    local platformType = "PC"
    if isMobile then
        platformType = "Mobile"
    elseif isConsole then
        platformType = "Console"
    end

    local deviceName = platformType
    pcall(function()
        if type(UserInputService.GetDeviceName) == "function" then
            local n = UserInputService:GetDeviceName()
            if n and tostring(n) ~= "" then
                deviceName = tostring(n)
            end
        end
    end)

    if deviceName == platformType then
        pcall(function()
            if type(UserInputService.GetPlatform) == "function" then
                local p = UserInputService:GetPlatform()
                if p then
                    deviceName = tostring(p):gsub("Enum%.Platform%.", "")
                end
            end
        end)
    end

    local executor = "Unknown"
    for _, fnName in ipairs({ "identifyexecutor", "getexecutorname" }) do
        local fn = FindInEnvs(fnName)
        if type(fn) == "function" then
            local ok, res = pcall(fn)
            if ok and res and tostring(res) ~= "" then
                executor = tostring(res)
                break
            end
        end
    end

    return platformType, deviceName, executor
end

