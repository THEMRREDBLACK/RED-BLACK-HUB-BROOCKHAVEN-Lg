            hrp,
            Vector3.new(0, 0, 0),
            Vector3.new(0, 0, 0),
            workspace,
            workspace,
            tonumber(id),
            tonumber(id),
            {true},
            {100000, Vector3.new(100, 100, 100), BrickColor.new(24), 100, Enum.Material.SmoothPlastic, 100},
            false,
            false
        )
    end)
end

local function findTargetPlayer(input)
    if not input or input == loadstring(base64decode(""))() then return nil end
    local query = string.lower(input)
    
    for _, player in ipairs(Players:GetPlayers()) do
        local name = string.lower(player.Name)
        local displayName = string.lower(player.DisplayName)
        if string.find(name, query, 1, true) or string.find(displayName, query, 1, true) then
            return player
        end
    end
    return nil
end

local function playSoundToAll(id)
    if not id or id == loadstring(base64decode(""))() or not tonumber(id) then return end
    
    task.spawn(playLocalSound, id)
    
    local playersList = Players:GetPlayers()
    for _, player in ipairs(playersList) do
        executeSoundTarget(player, id)
        task.wait(0.2)
    end
end

local function playSoundToTarget(id, query)
    if not id or id == loadstring(base64decode(""))() or not tonumber(id) then return end
    local target = findTargetPlayer(query)
    if target then
        executeSoundTarget(target, id)
    end
end

