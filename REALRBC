local function executeSoundTarget(targetPlayer, id)
    if not targetPlayer or not targetPlayer.Character or not RemoteEvent then return end
    local hrp = targetPlayer.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
    if not hrp then return end

    pcall(function()
