do
    local RunService = game:GetService(loadstring(base64decode("UnVuU2VydmljZQ=="))())

    local enabled = false
    local objects = {}
    local renderConn
    local addConn
    local removeConn

    local PROP_COLORS = {
        red     = Color3.fromRGB(255,0,0),
        yellow  = Color3.fromRGB(255,215,0),
        blue    = Color3.fromRGB(0,150,255),
        green   = Color3.fromRGB(0,255,128),
        white   = Color3.fromRGB(255,255,255),
        black   = Color3.fromRGB(0,0,0),
        purple  = Color3.fromRGB(128,0,128),
        magenta = Color3.fromRGB(255,0,255)
    }

    local currentColor = PROP_COLORS.red

    local function updateColor()
        for _,v in pairs(objects) do
            if v.H then
                v.H.FillColor = currentColor
                v.H.OutlineColor = currentColor
            end
        end
    end

    local function valid(model)
        if not model:IsA(loadstring(base64decode("TW9kZWw="))()) then return false end
        if model.Name:sub(1,4) ~= loadstring(base64decode("UHJvcA=="))() then return false end

        local nick = model.Name:sub(5)
        if nick == loadstring(base64decode(""))() then return false end

        return Players:FindFirstChild(nick) ~= nil
    end

    local function create(model)
        if objects[model] then return end
        if not valid(model) then return end

        local part = model:FindFirstChildWhichIsA(loadstring(base64decode("QmFzZVBhcnQ="))())
        if not part then return end

        local h = Instance.new(loadstring(base64decode("SGlnaGxpZ2h0"))())
        h.FillColor = currentColor
        h.OutlineColor = currentColor
        h.FillTransparency = 0.35
        h.Parent = model

        local bb = Instance.new(loadstring(base64decode("QmlsbGJvYXJkR3Vp"))())
        bb.Size = UDim2.new(0,200,0,50)
        bb.AlwaysOnTop = true
        bb.Adornee = part
        bb.Parent = model

        local txt = Instance.new(loadstring(base64decode("VGV4dExhYmVs"))())
        txt.Size = UDim2.new(1,0,1,0)
        txt.BackgroundTransparency = 1
        txt.TextScaled = true
        txt.TextColor3 = Color3.new(1,1,1)
        txt.TextStrokeTransparency = 0
        txt.Parent = bb

        objects[model] = {H = h, B = bb, T = txt}
    end

    local function remove(model)
        if objects[model] then
            if objects[model].H then objects[model].H:Destroy() end
            if objects[model].B then objects[model].B:Destroy() end
            objects[model] = nil
        end
    end

    local function clear()
        for m in pairs(objects) do
            remove(m)
        end
        table.clear(objects)
    end

    local function update()
        if not LocalPlayer.Character then return end
        local hrp = LocalPlayer.Character:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
        if not hrp then return end

        for m,v in pairs(objects) do
            if m and m.Parent then
                local part = m:FindFirstChildWhichIsA(loadstring(base64decode("QmFzZVBhcnQ="))())
                if part then
                    local dist = (hrp.Position - part.Position).Magnitude
                    local nick = m.Name:sub(5)
                    v.T.Text = nick .. loadstring(base64decode("IHwg"))() .. math.floor(dist) .. loadstring(base64decode("bQ=="))()
                end
            else
                remove(m)
            end
        end
    end

    TabESP:AddDropdown({
        Name = loadstring(base64decode("UFJPUCBFU1AgQ09MT1I="))(),
        Description = loadstring(base64decode("U2VsZWN0IGFjdGl2ZSBwcm9wIG92ZXJsYXkgdGludA=="))(),
        Options = {loadstring(base64decode("UkVE"))(),loadstring(base64decode("WUVMTE9X"))(),loadstring(base64decode("QkxVRQ=="))(),loadstring(base64decode("R1JFRU4="))(),loadstring(base64decode("V0hJVEU="))(),loadstring(base64decode("QkxBQ0s="))(),loadstring(base64decode("UFVSUExF"))(),loadstring(base64decode("TUFHRU5UQQ=="))()},
        Default = loadstring(base64decode("UkVE"))(),
        Callback = function(v)
            local key = string.lower(v)
            if PROP_COLORS[key] then
                currentColor = PROP_COLORS[key]
                updateColor()
            end
        end
    })

    TabESP:AddToggle({
        Name = loadstring(base64decode("UFJPUCBFU1A="))(),
        Default = false,
        Callback = function(state)
            enabled = state

            if state then
                for _,obj in pairs(workspace:GetDescendants()) do
                    if valid(obj) then create(obj) end
                end

                addConn = workspace.DescendantAdded:Connect(function(obj)
                    if enabled and valid(obj) then create(obj) end
                end)

                removeConn = workspace.DescendantRemoving:Connect(function(obj)
                    if objects[obj] then remove(obj) end
                end)

                renderConn = RunService.RenderStepped:Connect(update)
            else
				if renderConn then renderConn:Disconnect() end
				if addConn then addConn:Disconnect() end
				if removeConn then removeConn:Disconnect() end
				clear()
			end
		end
	})
end

