local function deleteSwing(meshName)
	local hrp = getHRP()
	if not hrp then return end
	
	local originalCFrame = hrp.CFrame
	local swingObj = nil
	
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == meshName then
			swingObj = obj
			break
		end
	end
	
	if swingObj then
		local targetCF = getCFrame(swingObj)
		if targetCF then
			hrp.CFrame = targetCF + Vector3.new(0, 1.5, 0)
			task.wait(0.1)
			hrp.CFrame = hrp.CFrame - Vector3.new(0, 900, 0)
			task.wait(0.1)
		end
	end
	
	hrp.CFrame = originalCFrame
end

