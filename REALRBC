local function getCharacterAndHumanoid()
    local char = LP.Character
    if not char then return nil, nil end
    local hum = char:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
    return char, hum
end

local function applyCharacterStats(char)
    if not char then return end
    local hum = char:WaitForChild(loadstring(base64decode("SHVtYW5vaWQ="))(), 5) or char:FindFirstChildOfClass(loadstring(base64decode("SHVtYW5vaWQ="))())
    if hum then
        pcall(function()
            hum.UseJumpPower = true
            hum.WalkSpeed = WALK_SPEED
            hum.JumpPower = JUMP_POWER
        end)
    end
end

local function stopSpin()
    SPIN_ENABLED = false
    if SPIN_CONN then
        pcall(function() SPIN_CONN:Disconnect() end)
        SPIN_CONN = nil
    end
end

local function startSpin()
    stopSpin() -- evita conexões duplicadas após respawn
    SPIN_ENABLED = true

    SPIN_CONN = RunService.Heartbeat:Connect(function(dt)
        if not SPIN_ENABLED then return end
        local char = LP.Character
        local hrp = char and char:FindFirstChild(loadstring(base64decode("SHVtYW5vaWRSb290UGFydA=="))())
        if hrp then
            local angleRad = math.rad(SPIN_SPEED * dt)
            pcall(function()
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, angleRad, 0)
            end)
        end
    end)
end

local function SPIN(on)
    if on == nil then
        if SPIN_ENABLED then stopSpin() else startSpin() end
    else
        if on then startSpin() else stopSpin() end
    end
end

if LP.Character then
